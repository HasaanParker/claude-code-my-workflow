# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
# .vscode/settings.json ships in the template (carries shipped Claude Code permission-mode
# recommendations — see TROUBLESHOOTING.md "Permissions / bypass / statusline" for the typo
# fix forkers need). Other .vscode/ content is developer-machine-specific.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
.quarto/

# quality_reports/ — this is a working dissertation repo (not a template
# being maintained for forkers), so plans / specs / session logs / decisions /
# preregistrations / merges DO commit so they sync across machines (per
# .claude/rules/meta-governance.md "Cross-Machine Access" table).
#
# audits/ and diagnoses/ stay ignored: audits are transient gap-analyses
# and diagnoses can contain real data values / file paths captured during
# debugging.
quality_reports/audits/*
quality_reports/diagnoses/*
quality_reports/checkpoints/*
!quality_reports/audits/.gitkeep
!quality_reports/diagnoses/.gitkeep
!quality_reports/checkpoints/.gitkeep

# R analysis outputs (per-paper) — generated artifacts; keep .gitkeep, ignore the rest
Papers/*/_outputs/*
!Papers/*/_outputs/.gitkeep

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds
